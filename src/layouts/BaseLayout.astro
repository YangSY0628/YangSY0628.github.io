---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  titleZh?: string;
  descriptionZh?: string;
}

const { title, description, titleZh = title, descriptionZh = description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={description}
      data-i18n-content
      data-en={description}
      data-zh={descriptionZh}
    />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-content data-en={title} data-zh={titleZh} />
    <meta
      property="og:description"
      content={description}
      data-i18n-content
      data-en={description}
      data-zh={descriptionZh}
    />
    <meta property="og:url" content={canonicalURL} />
    <title>{title}</title>
  </head>
  <body data-title-en={title} data-title-zh={titleZh}>
    <slot />
  </body>
</html>
