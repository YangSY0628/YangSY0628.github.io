---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import {
  experience,
  highlights,
  navigation,
  profile,
  projects,
  publications,
} from "../data/site";

const pageDescription =
  "Shiyuan Yang is a PhD student at the University of Macau working in robotics and autonomous systems.";
---

<BaseLayout title={`${profile.name} — ${profile.role}`} description={pageDescription}>
  <main class="shell">
    <section class="intro" aria-labelledby="page-title">
      <div class="intro-copy">
        <p class="eyebrow">Robotics · Autonomous Systems</p>
        <h1 id="page-title">{profile.name}</h1>
        <p class="role">{profile.role} at {profile.affiliation}</p>
        <p class="bio">{profile.introduction}</p>

        <div class="profile-links" aria-label="Profile links">
          <a href={`mailto:${profile.email}`}>
            <SocialIcon name="email" /> Email
          </a>
          <a href={profile.links.github} target="_blank" rel="noreferrer">
            <SocialIcon name="github" /> GitHub
          </a>
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer">
            <SocialIcon name="linkedin" /> LinkedIn
          </a>
        </div>
        <p class="email-text">{profile.email}</p>
      </div>

      <div class="portrait-placeholder" aria-label="Profile photo placeholder">
        <span>{profile.initials}</span>
        <small>Photo coming soon</small>
      </div>
    </section>

    <section class="work" aria-label="Academic profile">
      <div class="tabs" role="tablist" aria-label="Profile sections">
        {
          navigation.map((item, index) => (
            <button
              id={`tab-${item.id}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${item.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-tab={item.id}
            >
              {item.label}
            </button>
          ))
        }
      </div>

      <div class="panels">
        <section
          id="panel-highlights"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-highlights"
          data-panel="highlights"
        >
          {
            highlights.length > 0 ? (
              <div class="video-grid">
                {highlights.map((item) => (
                  <a
                    class="video-card"
                    href={`/research/${item.slug}/`}
                    aria-label={`View ${item.title} project page`}
                  >
                    <video
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      poster={item.poster}
                      data-preview
                      aria-label={`${item.title} research preview`}
                    >
                      <source src={item.video} type="video/mp4" />
                    </video>
                    <div class="video-caption">
                      <p>{item.eyebrow}</p>
                      <h2>{item.title}</h2>
                      <span>{item.description}</span>
                      <strong>View project →</strong>
                    </div>
                  </a>
                ))}
                <article class="video-card video-placeholder">
                  <div>
                    <p class="item-meta">More work</p>
                    <h2>Next highlight</h2>
                    <span>Another selected project will be added here.</span>
                  </div>
                </article>
              </div>
            ) : (
              <div class="empty-panel">
                <div class="research-mark" aria-hidden="true">
                  <span>R</span>
                </div>
                <div>
                  <p class="item-meta">In preparation</p>
                  <h2>Research highlights are coming soon.</h2>
                  <p>
                    Selected work will appear here with short explanations, experiment visuals, videos, and
                    links to papers or code.
                  </p>
                </div>
              </div>
            )
          }
        </section>

        <section
          id="panel-publications"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-publications"
          data-panel="publications"
          hidden
        >
          {
            publications.length > 0 ? (
              <div class="item-list">
                {publications.map((publication) => (
                  <article class="list-item">
                    <p class="item-year">{publication.year}</p>
                    <div>
                      <h2>{publication.title}</h2>
                      <p>{publication.authors}</p>
                      <p class="item-meta">{publication.venue}</p>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="text-empty">
                <p class="item-meta">Publications</p>
                <h2>Selected publications will be added here.</h2>
                <p>Paper, code, project-page, and video links will be included when available.</p>
              </div>
            )
          }
        </section>

        <section
          id="panel-projects"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-projects"
          data-panel="projects"
          hidden
        >
          {
            projects.length > 0 ? (
              <div class="card-grid">
                {projects.map((project) => (
                  <article class="card">
                    <h2>{project.title}</h2>
                    <p>{project.description}</p>
                    <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="text-empty">
                <p class="item-meta">Projects</p>
                <h2>Project stories and demonstrations are coming soon.</h2>
                <p>Each project will focus on the problem, personal contribution, method, and outcome.</p>
              </div>
            )
          }
        </section>

        <section
          id="panel-experience"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-experience"
          data-panel="experience"
          hidden
        >
          <div class="item-list">
            {
              experience.map((item) => (
                <article class="list-item">
                  <p class="item-year">{item.period}</p>
                  <div>
                    <h2>{item.role}</h2>
                    <p class="organization">{item.organization}</p>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </section>
  </main>

  <footer class="shell">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>Built with Astro · Hosted on GitHub Pages</p>
  </footer>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
    const previewVideos = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-preview]"));
    const intersectingVideos = new WeakSet<HTMLVideoElement>();
    const validTabs = new Set(tabs.map((tab) => tab.dataset.tab));

    function syncVideoPlayback() {
      previewVideos.forEach((video) => {
        const panel = video.closest<HTMLElement>("[data-panel]");
        const shouldPlay = !document.hidden && !panel?.hidden && intersectingVideos.has(video);

        if (shouldPlay) {
          video.play().catch(() => undefined);
        } else {
          video.pause();
        }
      });
    }

    function selectTab(tabId: string, updateHash = true) {
      if (!validTabs.has(tabId)) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.tab === tabId;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tabId;
      });

      localStorage.setItem("activeProfileTab", tabId);
      if (updateHash) history.replaceState(null, "", `#${tabId}`);
      syncVideoPlayback();
    }

    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) intersectingVideos.add(video);
          else intersectingVideos.delete(video);
        });
        syncVideoPlayback();
      },
      { threshold: 0.2 },
    );

    previewVideos.forEach((video) => videoObserver.observe(video));
    document.addEventListener("visibilitychange", syncVideoPlayback);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab.dataset.tab ?? "highlights"));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;

        const nextTab = tabs[nextIndex];
        selectTab(nextTab.dataset.tab ?? "highlights");
        nextTab.focus();
      });
    });

    const hashTab = window.location.hash.slice(1);
    const savedTab = localStorage.getItem("activeProfileTab");
    const initialTab = validTabs.has(hashTab) ? hashTab : savedTab;
    if (initialTab && validTabs.has(initialTab)) selectTab(initialTab, false);
  </script>
</BaseLayout>
