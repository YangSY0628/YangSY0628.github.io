---
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import SocialIcon from "../components/SocialIcon.astro";
import {
  education,
  experience,
  highlights,
  navigation,
  patentsNote,
  profile,
  projects,
  publications,
} from "../data/site";
import { zh } from "../data/zh";

const pageDescription =
  "Shiyuan Yang is a PhD student at the University of Macau working on heterogeneous multi-robot systems, graph neural networks, and vision-language-action models.";
const getZhHighlight = (slug: string) => zh.highlights[slug as keyof typeof zh.highlights];
---

<BaseLayout
  title={`${profile.name} — ${profile.role}`}
  description={pageDescription}
  titleZh={zh.meta.homeTitle}
  descriptionZh={zh.meta.homeDescription}
>
  <main class="shell">
    <section class="intro" aria-labelledby="page-title">
      <LanguageToggle />
      <div class="intro-copy">
        <p class="eyebrow">
          <span data-i18n data-en="Robotics · Autonomous Systems" data-zh={zh.profile.field}>
            Robotics · Autonomous Systems
          </span>
        </p>
        <h1 id="page-title">
          <span data-i18n data-en={profile.name} data-zh={zh.profile.name}>{profile.name}</span>
        </h1>
        <p class="role">
          <span
            data-i18n
            data-en={`${profile.role} at ${profile.affiliation}`}
            data-zh={`${zh.profile.role} · ${zh.profile.affiliation}`}
          >
            {profile.role} at {profile.affiliation}
          </span>
        </p>
        <p class="bio">
          <span data-i18n data-en={profile.introduction} data-zh={zh.profile.introduction}>
            {profile.introduction}
          </span>
        </p>

        <div
          class="profile-links"
          aria-label="Profile links"
          data-i18n-aria
          data-aria-en="Profile links"
          data-aria-zh={zh.common.profileLinks}
        >
          <a href={`mailto:${profile.email}`}>
            <SocialIcon name="email" />
            <span data-i18n data-en="Email" data-zh={zh.common.email}>Email</span>
          </a>
          <a href={profile.links.github} target="_blank" rel="noreferrer">
            <SocialIcon name="github" /> GitHub
          </a>
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer">
            <SocialIcon name="linkedin" /> LinkedIn
          </a>
        </div>
        <p class="email-text">{profile.email}</p>
      </div>

      <img
        class="portrait"
        src="/images/profile.jpeg"
        alt="Portrait of Shiyuan Yang"
        data-i18n-alt
        data-alt-en="Portrait of Shiyuan Yang"
        data-alt-zh={zh.profile.photoAlt}
        width="720"
        height="900"
        decoding="async"
        fetchpriority="high"
      />
    </section>

    <section
      class="work"
      aria-label="Academic profile"
      data-i18n-aria
      data-aria-en="Academic profile"
      data-aria-zh={zh.common.academicProfile}
    >
      <div
        class="tabs"
        role="tablist"
        aria-label="Profile sections"
        data-i18n-aria
        data-aria-en="Profile sections"
        data-aria-zh={zh.common.profileSections}
      >
        {
          navigation.map((item, index) => (
            <button
              id={`tab-${item.id}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${item.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-tab={item.id}
            >
              <span
                data-i18n
                data-en={item.label}
                data-zh={zh.navigation[item.id as keyof typeof zh.navigation]}
              >
                {item.label}
              </span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        <section
          id="panel-highlights"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-highlights"
          data-panel="highlights"
        >
          {
            highlights.length > 0 ? (
              <div class="video-grid">
                {highlights.map((item) => (
                  <a
                    class="video-card"
                    href={`/research/${item.slug}/`}
                    aria-label={`View ${item.title} project page`}
                    data-i18n-aria
                    data-aria-en={`View ${item.title} project page`}
                    data-aria-zh={`查看${getZhHighlight(item.slug).title}项目页面`}
                  >
                    <video
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      poster={item.poster}
                      data-preview
                      aria-label={`${item.title} research preview`}
                      data-i18n-aria
                      data-aria-en={`${item.title} research preview`}
                      data-aria-zh={`${getZhHighlight(item.slug).title}研究预览`}
                    >
                      <source src={item.video} type="video/mp4" />
                    </video>
                    <div class="video-caption">
                      <p>
                        <span
                          data-i18n
                          data-en={item.eyebrow}
                          data-zh={getZhHighlight(item.slug).eyebrow}
                        >
                          {item.eyebrow}
                        </span>
                      </p>
                      <h2>
                        <span data-i18n data-en={item.title} data-zh={getZhHighlight(item.slug).title}>
                          {item.title}
                        </span>
                      </h2>
                      <span
                        data-i18n
                        data-en={item.description}
                        data-zh={getZhHighlight(item.slug).description}
                      >
                        {item.description}
                      </span>
                      <strong data-i18n data-en="View project →" data-zh={zh.common.viewProject}>
                        View project →
                      </strong>
                    </div>
                  </a>
                ))}
                <article class="video-card video-placeholder">
                  <div>
                    <p class="item-meta">
                      <span data-i18n data-en="More work" data-zh={zh.empty.moreWork}>More work</span>
                    </p>
                    <h2>
                      <span data-i18n data-en="Next highlight" data-zh={zh.empty.nextHighlight}>
                        Next highlight
                      </span>
                    </h2>
                    <span
                      data-i18n
                      data-en="Another selected project will be added here."
                      data-zh={zh.empty.nextHighlightDescription}
                    >
                      Another selected project will be added here.
                    </span>
                  </div>
                </article>
              </div>
            ) : (
              <div class="empty-panel">
                <div class="research-mark" aria-hidden="true">
                  <span>R</span>
                </div>
                <div>
                  <p class="item-meta">
                    <span data-i18n data-en="In preparation" data-zh={zh.empty.inPreparation}>
                      In preparation
                    </span>
                  </p>
                  <h2>
                    <span
                      data-i18n
                      data-en="Research highlights are coming soon."
                      data-zh={zh.empty.highlightsTitle}
                    >
                      Research highlights are coming soon.
                    </span>
                  </h2>
                  <p>
                    <span
                      data-i18n
                      data-en="Selected work will appear here with short explanations, experiment visuals, videos, and links to papers or code."
                      data-zh={zh.empty.highlightsDescription}
                    >
                      Selected work will appear here with short explanations, experiment visuals, videos,
                      and links to papers or code.
                    </span>
                  </p>
                </div>
              </div>
            )
          }
        </section>

        <section
          id="panel-publications"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-publications"
          data-panel="publications"
          hidden
        >
          {
            publications.length > 0 ? (
              <div class="panel-groups">
                <div class="item-list">
                  {publications.map((publication, index) => (
                    <article class="list-item">
                      <p class="item-year">{publication.year}</p>
                      <div>
                        <h2>
                          <span
                            data-i18n
                            data-en={publication.title}
                            data-zh={zh.publications[index].title}
                          >
                            {publication.title}
                          </span>
                        </h2>
                        <p>{publication.authors}</p>
                        <p class="item-meta">
                          <span
                            data-i18n
                            data-en={publication.venue}
                            data-zh={zh.publications[index].venue}
                          >
                            {publication.venue}
                          </span>
                        </p>
                        {(publication.paper || publication.code) && (
                          <p class="item-links">
                            {publication.paper && (
                              <a href={publication.paper} target="_blank" rel="noreferrer">
                                <span data-i18n data-en="Paper" data-zh={zh.common.paper}>Paper</span>
                              </a>
                            )}
                            {publication.code && (
                              <a href={publication.code} target="_blank" rel="noreferrer">
                                <span data-i18n data-en="Code" data-zh={zh.common.code}>Code</span>
                              </a>
                            )}
                          </p>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
                <p class="panel-note">
                  <span data-i18n data-en={patentsNote} data-zh={zh.patentsNote}>{patentsNote}</span>
                </p>
              </div>
            ) : (
              <div class="text-empty">
                <p class="item-meta">
                  <span data-i18n data-en="Publications" data-zh={zh.empty.publications}>Publications</span>
                </p>
                <h2>
                  <span
                    data-i18n
                    data-en="Selected publications will be added here."
                    data-zh={zh.empty.publicationsTitle}
                  >
                    Selected publications will be added here.
                  </span>
                </h2>
                <p>
                  <span
                    data-i18n
                    data-en="Paper, code, project-page, and video links will be included when available."
                    data-zh={zh.empty.publicationsDescription}
                  >
                    Paper, code, project-page, and video links will be included when available.
                  </span>
                </p>
              </div>
            )
          }
        </section>

        <section
          id="panel-projects"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-projects"
          data-panel="projects"
          hidden
        >
          {
            projects.length > 0 ? (
              <div class="card-grid">
                {projects.map((project, index) => (
                  <article class="card">
                    <h2>
                      <span data-i18n data-en={project.title} data-zh={zh.projects[index].title}>
                        {project.title}
                      </span>
                    </h2>
                    <p>
                      <span
                        data-i18n
                        data-en={project.description}
                        data-zh={zh.projects[index].description}
                      >
                        {project.description}
                      </span>
                    </p>
                    <div class="tags">
                      {project.tags.map((tag, tagIndex) => (
                        <span>
                          <span data-i18n data-en={tag} data-zh={zh.projects[index].tags[tagIndex]}>
                            {tag}
                          </span>
                        </span>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="text-empty">
                <p class="item-meta">
                  <span data-i18n data-en="Projects" data-zh={zh.empty.projects}>Projects</span>
                </p>
                <h2>
                  <span
                    data-i18n
                    data-en="Project stories and demonstrations are coming soon."
                    data-zh={zh.empty.projectsTitle}
                  >
                    Project stories and demonstrations are coming soon.
                  </span>
                </h2>
                <p>
                  <span
                    data-i18n
                    data-en="Each project will focus on the problem, personal contribution, method, and outcome."
                    data-zh={zh.empty.projectsDescription}
                  >
                    Each project will focus on the problem, personal contribution, method, and outcome.
                  </span>
                </p>
              </div>
            )
          }
        </section>

        <section
          id="panel-experience"
          class="panel"
          role="tabpanel"
          aria-labelledby="tab-experience"
          data-panel="experience"
          hidden
        >
          <div class="panel-groups">
            {
              [
                {
                  label: "Work and research",
                  labelZh: zh.common.workAndResearch,
                  items: experience,
                  itemsZh: zh.experience,
                },
                {
                  label: "Education",
                  labelZh: zh.common.education,
                  items: education,
                  itemsZh: zh.education,
                },
              ].map((group) => (
                <section class="panel-group">
                  <p class="item-meta">
                    <span data-i18n data-en={group.label} data-zh={group.labelZh}>{group.label}</span>
                  </p>
                  <div class="item-list">
                    {group.items.map((item, index) => (
                      <article class="list-item">
                        <p class="item-year">
                          <span data-i18n data-en={item.period} data-zh={group.itemsZh[index].period}>
                            {item.period}
                          </span>
                        </p>
                        <div>
                          <h2>
                            <span data-i18n data-en={item.role} data-zh={group.itemsZh[index].role}>
                              {item.role}
                            </span>
                          </h2>
                          <p class="organization">
                            <span
                              data-i18n
                              data-en={item.organization}
                              data-zh={group.itemsZh[index].organization}
                            >
                              {item.organization}
                            </span>
                          </p>
                          <p>
                            <span
                              data-i18n
                              data-en={item.description}
                              data-zh={group.itemsZh[index].description}
                            >
                              {item.description}
                            </span>
                          </p>
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              ))
            }
          </div>
        </section>
      </div>
    </section>
  </main>

  <footer class="shell">
    <p>
      © {new Date().getFullYear()}{" "}
      <span data-i18n data-en={profile.name} data-zh={zh.profile.name}>{profile.name}</span>
    </p>
    <p>
      <span data-i18n data-en="Built with Astro · Hosted on GitHub Pages" data-zh={zh.common.builtWith}>
        Built with Astro · Hosted on GitHub Pages
      </span>
    </p>
  </footer>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
    const previewVideos = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-preview]"));
    const intersectingVideos = new WeakSet<HTMLVideoElement>();
    const validTabs = new Set(tabs.map((tab) => tab.dataset.tab));

    function syncVideoPlayback() {
      previewVideos.forEach((video) => {
        const panel = video.closest<HTMLElement>("[data-panel]");
        const shouldPlay = !document.hidden && !panel?.hidden && intersectingVideos.has(video);

        if (shouldPlay) {
          video.play().catch(() => undefined);
        } else {
          video.pause();
        }
      });
    }

    function selectTab(tabId: string, updateHash = true) {
      if (!validTabs.has(tabId)) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.tab === tabId;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tabId;
      });

      localStorage.setItem("activeProfileTab", tabId);
      if (updateHash) history.replaceState(null, "", `#${tabId}`);
      syncVideoPlayback();
    }

    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) intersectingVideos.add(video);
          else intersectingVideos.delete(video);
        });
        syncVideoPlayback();
      },
      { threshold: 0.2 },
    );

    previewVideos.forEach((video) => videoObserver.observe(video));
    document.addEventListener("visibilitychange", syncVideoPlayback);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab.dataset.tab ?? "highlights"));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;

        const nextTab = tabs[nextIndex];
        selectTab(nextTab.dataset.tab ?? "highlights");
        nextTab.focus();
      });
    });

    const hashTab = window.location.hash.slice(1);
    const savedTab = localStorage.getItem("activeProfileTab");
    const initialTab = validTabs.has(hashTab) ? hashTab : savedTab;
    if (initialTab && validTabs.has(initialTab)) selectTab(initialTab, false);
  </script>
</BaseLayout>
